{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "py-sema",
  "colors": {
    "primary": "#0D9488",
    "light": "#14B8A6",
    "dark": "#0F766E"
  },
  "favicon": "/favicon.svg",
  "navigation": {
    "pages": [
      {
        "group": "Getting Started",
        "pages": [
          "index",
          "quickstart"
        ]
      },
      {
        "group": "Core CLI Tools",
        "pages": [
          "cli/bench",
          "cli/harvest",
          "cli/subyt",
          "cli/query",
          "cli/discovery",
          "cli/syncfs"
        ]
      },
      {
        "group": "Specialized Tools",
        "pages": [
          "utilities/ro-crate",
          "utilities/reason",
          "utilities/aggregation",
          "utilities/conneg"
        ]
      },
      {
        "group": "Python API & Commons",
        "pages": [
          "python-api/overview",
          "python-api/commons",
          "python-api/architecture"
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "GitHub Repository",
          "href": "https://github.com/vliz-be-opsci/py-sema",
          "icon": "github"
        }
      ]
    }
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "navbar": {
    "links": [
      {
        "label": "GitHub",
        "href": "https://github.com/vliz-be-opsci/py-sema"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Repository",
      "href": "https://github.com/vliz-be-opsci/py-sema"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ]
  },
  "footer": {
    "socials": {
      "github": "https://github.com/vliz-be-opsci/py-sema"
    }
  }
}
